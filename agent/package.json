    "@langchain/langgraph": "^1.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "langsmith": "^0.7.3",
    "libphonenumber-js": "^1.12.31",
    "nanoid": "^5.1.6",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
